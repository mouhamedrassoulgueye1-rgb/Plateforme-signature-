# Même mise en forme pour tout le monde (VS Code : extension « EditorConfig for VS Code »)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
